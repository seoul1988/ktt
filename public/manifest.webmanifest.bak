{
  "name": "KTown Triangle",
  "short_name": "KTown",
  "description": "Korean community map and marketplace app",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#F8F3EC",
  "theme_color": "#172033",
  "orientation": "portrait",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "share_target": {
    "action": "/share/news",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}